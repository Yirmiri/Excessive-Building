{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "*",
        "sources": "*"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "net.yirmiri.excessive_building.FabricExcessiveBuilding"
        ],
        "client": [
          "net.yirmiri.excessive_building.FabricExcessiveBuildingClient"
        ],
        "fabric-datagen": [
          "net.yirmiri.excessive_building.FabricExcessiveBuildingDatagen"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "runiclib": ">=5.0.7"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  